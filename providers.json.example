{
  "_comment": "此文件包含 API key 等敏感信息，复制为 providers.json 后填写真实值。providers.json 已加入 .gitignore，不会被提交。",

  "llm_fallback_chain": [
    {
      "_comment": "主配置（第一条），Anthropic 多 key 轮转",
      "provider": "anthropic",
      "model": "claude-opus-4-7",
      "api_keys": [
        "sk-ant-key-1-...",
        "sk-ant-key-2-..."
      ],
      "key_rotation": "passive",
      "key_switch_on": ["LLMRateLimitError"],
      "key_cooldown": 60
    },
    {
      "_comment": "备用配置，OpenAI fallback",
      "provider": "openai",
      "model": "gpt-4o",
      "api_key": "sk-openai-...",
      "key_rotation": "passive"
    }
  ],

  "llm_fallback_on": [
    "LLMRateLimitError",
    "LLMTimeoutError",
    "LLMProviderError"
  ],

  "_comment_providers": "providers 块为全局 per-provider 设置，会合并到 llm_fallback_chain 的对应条目中（条目的显式字段优先）",
  "providers": {
    "anthropic": {
      "api_keys": [
        "sk-ant-key-1-...",
        "sk-ant-key-2-..."
      ],
      "key_rotation": "round_robin",
      "key_cooldown": 60
    },
    "openai": {
      "api_keys": [
        "sk-openai-key-1-...",
        "sk-openai-key-2-..."
      ],
      "key_rotation": "passive"
    },
    "_comment_openrouter": "OpenRouter：统一网关，可访问 100+ 模型。模型 ID 格式为 'provider/model-name'",
    "openrouter": {
      "api_key": "sk-or-...",
      "key_rotation": "passive",
      "_comment_extra": "可选：通过 extra 覆盖请求头中的应用标识（用于 OpenRouter 统计）",
      "extra": {
        "http_referer": "https://your-site.com",
        "x_title": "YourAppName"
      }
    }
  },

  "_comment_openrouter_examples": "OpenRouter 使用示例",
  "_openrouter_examples": {
    "claude_via_openrouter": {
      "provider": "openrouter",
      "model": "anthropic/claude-opus-4-7",
      "api_key": "sk-or-..."
    },
    "gpt4o_via_openrouter": {
      "provider": "openrouter",
      "model": "openai/gpt-4o",
      "api_key": "sk-or-..."
    },
    "llama_via_openrouter": {
      "provider": "openrouter",
      "model": "meta-llama/llama-3.1-405b-instruct",
      "api_key": "sk-or-..."
    },
    "gemini_via_openrouter": {
      "provider": "openrouter",
      "model": "google/gemini-2.5-pro",
      "api_key": "sk-or-..."
    }
  }
}
