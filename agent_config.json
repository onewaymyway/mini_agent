{
  "system_message_format": "system_role",
  "system_tool_call": true,
  "claude_md_file": "Agent.md",
  "verbose": true,
  "memory_enabled": true,
  "memory": {
    "per_turn_retrieval_enabled": false
  },
  "lesson_rules_enabled": true,
  "lesson_fail_threshold": 3,
  "correction_detection_enabled": true,
  "profile_min_entries": 3,
  "profile_refresh_interval_entries": 5,
  "profile_max_entries": 20,
  "session_summary_enabled": true,
  "session_summary_min_turns": 3,
  "profile_enabled": true,
  "bash_stream_output_enabled": false,
  "skill_keyword_activation_enabled": false,
  "artifact_auto_detect_enabled": false,
  "max_llm_calls": 4,
  "llm_retry_delay": 30,
  "max_turns": 50,
  "max_turns_on_limit": "compact_continue",
  "max_turns_hard_limit": 250,
  "show_reasoning": false,
  "tool_trim": {
    "enabled": true
  },
  "raw_output": false,
  "web_search": {
    "provider": "duckduckgo",
    "api_key": "",
    "max_results": 5,
    "timeout": 10.0
  },
  "tech_radar": {
    "enabled": true,
    "keywords": [
      "AI Agent 架构",
      "LLM 长上下文"
    ],
    "daily_seed_limit": 5,
    "max_search_results": 5
  },
  "mcp_servers": [
    {
      "name": "time_server",
      "transport": "stdio",
      "command": "python",
      "args": [
        "mcp_servers/time_server.py"
      ],
      "auto_approve": true,
      "timeout": 10.0,
      "enabled": true
    }
  ],
  "env_info": {
    "enabled": true,
    "providers": [
      "builtin.system",
      "builtin.runtime",
      "builtin.locale",
      "myplugins.git_info.GitInfoProvider"
    ],
    "provider_kwargs": {
      "builtin.system": {
        "include_hostname": false
      }
    }
  },
  "privacy": {
    "enabled": true,
    "verbose": true,
    "secrets": [
      {
        "name": "MY_DB_PASSWORD",
        "value": "super-secret-pw"
      }
    ],
    "auto_env_patterns": null
  },
  "goal_mode": {
    "enabled": true,
    "judge_tools_enabled": true,
    "judge_yes_mode": true,
    "max_rounds": 20,
    "max_total_compacts": 500,
    "consecutive_same_feedback_limit": 3,
    "same_feedback_similarity_threshold": 0.9,
    "persist_state": true,
    "auto_resume_prompt": true,
    "judge_show_prompt": true
  },
  "turn_judge": {
    "enabled": false,
    "judge_model": null,
    "judge_provider": null,
    "max_auto_rounds": 99999,
    "judge_show_prompt": true,
    "history_window": 6,
    "consecutive_same_output_limit": 3,
    "same_output_similarity_threshold": 0.9,
    "max_stuck_recoveries": 3
  },
  "token_estimate_enabled": true,
  "auto_compress_enabled": true,
  "auto_compress_threshold": 0.7,
  "auto_compress_strategy": "compact_with_skills",
  "compact_turn_count_trigger_enabled": true,
  "compact_max_turns": 40,
  "compact_tool_call_count_trigger_enabled": true,
  "compact_max_tool_calls": 90,
  "compact_topic_shift_detection": "llm",
  "compact_topic_shift_keyword_overlap_threshold": 0.15,
  "compact_redundancy_detection_enabled": true,
  "compact_redundancy_tool_result_ratio": 0.6,
  "compact_cooldown_turns": 3,
  "compact_require_confirmation": false,
  "compact_max_message_chars": 10000,
  "model_context_window": 120000,
  "digest_advisor": {
    "daily_digest_enabled": true,
    "daily_digest_startup_print_enabled": true,
    "next_action_enabled": true,
    "next_action_startup_print_enabled": true,
    "next_action_rank_with_llm": false,
    "next_action_stale_days": 7.0,
    "next_action_stale_priority_floor": 1,
    "next_action_attention_window_hours": 6.0,
    "next_action_attention_mismatch_ratio": 0.5,
    "next_action_profile_weighting_enabled": false,
    "next_action_profile_weighting_min_confidence": 0.5,
    "next_action_push_enabled": false,
    "next_action_push_threshold_hours": 2.0,
    "next_action_push_max_per_session": 1,
    "decision_profile_enabled": false,
    "decision_profile_min_evidence_count": 3
  },
  "workflow": {
    "parallel_enabled": true,
    "max_parallel": 4,
    "watchdog_enabled": true,
    "heartbeat_check_interval_seconds": 5.0,
    "max_total_duration_seconds": null,
    "approval_poll_interval_seconds": 3.0,
    "approval_wait_timeout_seconds": 600.0,
    "retry_on_error_backoff_seconds": 5.0,
    "background_execution_default": false,
    "hooks_enabled": true,
    "max_sub_workflow_depth": 3,
    "script_step_enabled": true,
    "script_step_timeout_seconds": 60.0,
    "tool_call_step_auto_approve": true,
    "human_input_wait_timeout_seconds": 1800.0,
    "validate_placeholders_on_save": true,
    "validate_role_refs_on_save": true,
    "session_to_workflow_enabled": true,
    "condition_static_check_enabled": true,
    "dry_run_preview_on_generate": true,
    "git_hint_enabled": true,
    "python_step_enabled":true
  }
}