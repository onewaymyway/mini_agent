{
  "model": "qwen/qwen3.5-122b-a10b",
  "provider": "nvidia",
  "system_message_format": "system_role",
  "verbose": true,
  "memory_enabled": true,
  "profile_min_entries":3,
  "profile_refresh_interval_entries":5,
  "profile_max_entries":20,
  "session_summary_enabled": true,
  "session_summary_min_turns": 3,
  "profile_enabled":true,
  "max_llm_calls": 4,

  "web_search": {
    "provider": "duckduckgo",
    "api_key": "",
    "max_results": 5,
    "timeout": 10.0
  },

  "mcp_servers": [
    {
      "name": "time_server",
      "transport": "stdio",
      "command": "python",
      "args": ["mcp_servers/time_server.py"],
      "auto_approve": true,
      "timeout": 10.0,
      "enabled": true
    }
  ]
}