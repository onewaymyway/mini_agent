<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：把聚合后的数据 POST 给 mini_agent；只用于访问用户自己配置的局域网地址 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- App 使用统计：需要用户在系统设置里手动单独授权，代码里只是跳转过去 -->
    <!-- 无需在 manifest 里声明 PACKAGE_USAGE_STATS（它是特殊权限，走 AppOpsManager） -->

    <!-- 开机自启，重新注册定时任务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 地理围栏：只用来在本地判断"进入/离开 home 或 work"，坐标不会被上报 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Health Connect 读取步数/睡眠聚合数据 -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <application
        android:allowBackup="false"
        android:label="mini_agent Behavior Companion"
        android:theme="@style/Theme.MiniAgentBehavior">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ScreenEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.SCREEN_OFF" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- Health Connect 权限申请所需的声明（用于系统权限选择页展示这个 App） -->
        <activity-alias
            android:name=".HealthConnectPermissionsRationaleActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
