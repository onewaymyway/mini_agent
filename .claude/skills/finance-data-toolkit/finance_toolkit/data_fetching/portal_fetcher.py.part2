

# ==================== 统一入口 ====================

class PortalDataFetcher:
    """门户网站数据统一抓取器"""
    
    def __init__(self):
        self.tencent = TencentPortalFetcher()
        self.sina = SinaPortalFetcher()
    
    def fetch_all(self, codes: List[str] = None) -> Dict:
        """抓取所有门户数据"""
        if codes is None:
            codes = ['600519', '000858', '000001', '601318', '600036', 
                     '002594', '601012', '002475', '600900', '000333']
        
        result = {
            'fetch_time': datetime.now().isoformat(),
            'sources': {},
            'stocks': [],
            'indices': [],
            'hot_stocks': [],
        }
        
        # 1. 抓取大盘指数
        print("[Portal] Fetching market indices...")
        indices = self.tencent.fetch_market_indices()
        result['indices'] = indices
        result['sources']['tencent_indices'] = len(indices)
        
        # 2. 抓取热点股票
        print("[Portal] Fetching hot stocks...")
        hot_stocks = self.tencent.fetch_hot_stocks(50)
        result['hot_stocks'] = hot_stocks
        result['sources']['tencent_hot'] = len(hot_stocks)
        
        # 3. 抓取指定股票实时行情
        print(f"[Portal] Fetching {len(codes)} stocks...")
        for code in codes:
            tc_data = self.tencent.fetch_realtime_quote(code)
            if tc_data:
                result['stocks'].append(tc_data)
            
            sina_data = self.sina.fetch_realtime_quote(code)
            if sina_data:
                result['stocks'].append(sina_data)
            
            time.sleep(0.05)
        
        result['sources']['total_stocks'] = len(result['stocks'])
        return result
    
    def save_to_file(self, data: Dict, output_dir: str) -> str:
        """保存数据到文件"""
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"portal_stock_data_{timestamp}.json"
        filepath = os.path.join(output_dir, filename)
        
        os.makedirs(output_dir, exist_ok=True)
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        
        return filepath


def main():
    """主函数 - 测试入口"""
    output_dir = r"E:\codes\mini_claude_code\research\stock_analyse"
    
    fetcher = PortalDataFetcher()
    
    print("=" * 50)
    print("门户网站A股数据抓取测试")
    print("=" * 50)
    
    data = fetcher.fetch_all()
    
    filepath = fetcher.save_to_file(data, output_dir)
    
    print(f"\n抓取结果:")
    print(f"  - 大盘指数: {len(data['indices'])} 个")
    print(f"  - 热点股票: {len(data['hot_stocks'])} 只")
    print(f"  - 实时行情: {len(data['stocks'])} 条")
    print(f"  - 数据源: {data['sources']}")
    print(f"\n数据已保存至: {filepath}")
    
    if data['stocks']:
        print(f"\n前10条股票数据:")
        for i, stock in enumerate(data['stocks'][:10], 1):
            payload = stock.get('payload', {})
            print(f"  {i}. {payload.get('name', '')} ({stock.get('symbol', '')}) "
                  f"价格: {payload.get('price', 0):.2f} "
                  f"涨跌: {payload.get('change_pct', 0):.2f}%")


if __name__ == "__main__":
    main()
