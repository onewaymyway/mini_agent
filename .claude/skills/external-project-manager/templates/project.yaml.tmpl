# project.yaml — {{PROJECT_NAME}} 与 daemon 之间唯一的契约
#
# 完整字段参考见同一 skill 目录下 reference/project_yaml_schema.md
# （对齐 src/mini_agent/external_projects/manifest.py 的实际校验规则）。
# 本文件由 external-project-manager skill 的 scaffold.py 生成，占位
# entrypoint（main）需要你按实际业务改名/拆分/补充，字段结构保持合法。

name: {{PROJECT_NAME}}

entrypoints:
  # 占位 entrypoint：先跑通"骨架合法 + 能被 daemon/CLI 触发"，再把
  # entrypoints/main.py 里的 TODO 替换成真正的业务逻辑。可以按需拆成
  # 多个 entrypoint（比如"抓取"和"分析"分开），每个都要有自己的
  # entrypoints/<key>.py 脚本。
  main:
    cmd: "python entrypoints/main.py"
    # 如果这个 entrypoint 需要定时跑，取消下一行注释并按 crontab 语法
    # 填 5 个字段；不需要定时（按需手动/被大管家触发）就删掉这一行。
    # schedule: "cron: 0 9 * * 1-5"
    timeout_sec: 300
    # 如果这个 entrypoint 需要外部传参（比如指定某个标的代码），按下面
    # 的格式声明，看板「手动触发」会据此渲染输入框；不需要就删掉
    # 整个 params 块。
    # params:
    #   - name: target
    #     required: true
    #     help: "说明这个参数是干什么的"

health_check:
  cmd: "python entrypoints/health.py"

resources:
  # 这个项目的 entrypoint 会访问哪些外部域名，先列出已知的，后续按需
  # 补充；留空数组表示暂不做域名白名单限制。
  allowed_domains: []
  max_concurrency: 1

# 周期性"改进 review session"——见 stock_watch_continuous_improvement_plan.md
# 阶段4。cadence 目前只支持描述性字符串（daemon 侧真正的定时接线视该
# 文档实施进度而定），enabled=false 时 `mini-agent projects review` 只会
# 提示"未开启"，不影响其它命令。
review:
  cadence: weekly
  enabled: false

# 可选：如果这个项目的核心数据有"状态流转"语义（比如候选池条目在几个
# 状态之间迁移），参考 stock_watch/project.yaml 的 dashboard.kanban_view
