"""
P0 网站测试运行器

执行 P0 优先级网站的测试用例，覆盖核心操作能力：
- OP-001: 页面加载能力
- OP-002: 元素定位能力
- OP-003: 点击交互能力
- OP-004: 输入操作能力
- OP-005: 数据提取能力
- OP-006: 截图能力
- OP-007: 滚动操作能力
- OP-008: 多标签页管理
- OP-009: 等待策略
- OP-010: 错误恢复

使用方式:
    python run_p0_tests.py --websites baidu,zhihu,gov_cn --headless
    python run_p0_tests.py --all-p0 --parallel
    python run_p0_tests.py --websites baidu --capabilities nav,locate,extract
"""

import argparse
import json
import logging
import sys
import time
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional

