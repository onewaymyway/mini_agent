
# ==================== 测试执行器 ====================

class P0TestExecutor:
    """P0 测试执行器"""

    def __init__(self, headless: bool = True, timeout: int = 30):
        self.headless = headless
        self.timeout = timeout
        self.playwright = None
        self.browser = None
        self.results: List[WebsiteTestReport] = []

    def initialize(self):
        """初始化测试环境"""
        try:
            from playwright.sync_api import sync_playwright
            self.playwright = sync_playwright().start()
            self.browser = self.playwright.chromium.launch(
                headless=self.headless,
                args=[
                    '--disable-blink-features=AutomationControlled',
                    '--no-sandbox',
                    '--disable-dev-shm-usage',
                ],
            )
            logger.info("浏览器初始化成功")
            return True
        except Exception as e:
            logger.error(f"浏览器初始化失败: {e}")
            return False

    def cleanup(self):
        """清理测试环境"""
        if self.browser:
            try:
                self.browser.close()
            except Exception:
                pass
        if self.playwright:
            try:
                self.playwright.stop()
            except Exception:
                pass

    def run_test(self, website_key: str, test_func) -> TestResult:
        """运行单个测试用例"""
        website = P0_WEBSITES.get(website_key)
        if not website:
            return TestResult(
                test_id="ERR",
                test_name="未知网站",
                website_name=website_key,
                capability="ERROR",
                success=False,
                duration=0,
                score=0,
                error=f"网站 {website_key} 未在配置中定义",
            )

        start_time = time.time()
        try:
            context = self.browser.new_context(
                user_agent='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
                viewport={'width': 1920, 'height': 1080},
            )
            page = context.new_page()

            test_result = test_func(page, website)
            duration = time.time() - start_time

            context.close()

            return TestResult(
                test_id=test_result.get("test_id", "UNKNOWN"),
                test_name=test_result.get("test_name", "未知测试"),
                website_name=website["name"],
                capability=test_result.get("capability", "UNKNOWN"),
                success=test_result.get("success", False),
                duration=duration,
                score=test_result.get("score", 0),
                error=test_result.get("error"),
                details=test_result.get("details", {}),
            )
        except Exception as e:
            duration = time.time() - start_time
            return TestResult(
                test_id="ERR",
                test_name="执行异常",
                website_name=website["name"],
                capability="ERROR",
                success=False,
                duration=duration,
                score=0,
                error=str(e),
            )

    def run_all_tests(self, website_keys: List[str], capabilities: Optional[List[str]] = None) -> List[WebsiteTestReport]:
        """运行所有测试"""
        if not self.initialize():
            logger.error("浏览器初始化失败，无法执行测试")
            return []

        try:
            for key in website_keys:
                if key not in P0_WEBSITES:
                    logger.warning(f"跳过未知网站: {key}")
                    continue

                website = P0_WEBSITES[key]
                report = WebsiteTestReport(
                    website_name=website["name"],
                    website_url=website["url"],
                    category=website["category"],
                    test_time=datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                )

                test_functions = {
                    "nav": self._test_navigation,
                    "locate": self._test_element_location,
                    "click": self._test_click_interaction,
                    "input": self._test_input_operation,
                    "extract": self._test_data_extraction,
                    "screenshot": self._test_screenshot,
                    "scroll": self._test_scroll_operation,
                    "tab": self._test_tab_management,
                    "wait": self._test_smart_wait,
                    "recover": self._test_error_recovery,
                }

                caps_to_run = capabilities or list(test_functions.keys())
                for cap in caps_to_run:
                    if cap in test_functions:
                        result = self.run_test(key, test_functions[cap])
                        report.results.append(result)
                        logger.info(f"[{result.test_id}] {result.test_name}: {'✓' if result.success else '✗'}")

                self.results.append(report)

        finally:
            self.cleanup()

        return self.results

    # ==================== 测试用例实现 ====================

    def _test_navigation(self, page, website: Dict) -> Dict:
        """OP-001: 页面加载能力测试"""
        start = time.time()
        try:
            response = page.goto(website["url"], timeout=self.timeout * 1000, wait_until="domcontentloaded")
            status = response.status if response else 0
            load_time = time.time() - start

            title = page.title()
            url = page.url

            success = 200 <= status < 400 and len(title) > 0
            score = min(100, (1 - load_time / self.timeout) * 100) if success else 0

            return {
                "test_id": f"NAV_{website['domain'][:8].upper()}_001",
                "test_name": f"首页访问测试 - {website['name']}",
                "capability": "OP-001 页面加载",
                "success": success,
                "score": round(score, 1),
                "duration": load_time,
                "details": {"status_code": status, "load_time": round(load_time, 2), "title": title, "final_url": url},
            }
        except Exception as e:
            load_time = time.time() - start
            return {
                "test_id": f"NAV_{website['domain'][:8].upper()}_001",
                "test_name": f"首页访问测试 - {website['name']}",
                "capability": "OP-001 页面加载",
                "success": False,
                "score": 0,
                "error": str(e),
                "details": {"load_time": round(load_time, 2)},
            }

    def _test_element_location(self, page, website: Dict) -> Dict:
        """OP-002: 元素定位能力测试"""
        try:
            page.goto(website["url"], timeout=self.timeout * 1000, wait_until="domcontentloaded")
            page.wait_for_timeout(2000)

            results = []
            total_score = 0

            for elem_name, selector in website.get("expected_elements", {}).items():
                try:
                    selectors = selector.split(", ")
                    found = False
                    for sel in selectors:
                        sel = sel.strip()
                        if page.locator(sel).count() > 0:
                            found = True
                            count = page.locator(sel).count()
                            results.append({"element": elem_name, "selector": sel, "found": True, "count": count})
                            total_score += 30
                            break
                    if not found:
                        results.append({"element": elem_name, "selector": selector, "found": False})
                        total_score += 10
                except Exception:
                    results.append({"element": elem_name, "found": False, "error": "选择器无效"})
                    total_score += 5

            success = total_score >= 30
            score = min(100, total_score)

            return {
                "test_id": f"LOC_{website['domain'][:8].upper()}_001",
                "test_name": f"元素定位测试 - {website['name']}",
                "capability": "OP-002 元素定位",
                "success": success,
                "score": round(score, 1),
                "details": {"elements": results},
            }
        except Exception as e:
            return {
                "test_id": f"LOC_{website['domain'][:8].upper()}_001",
                "test_name": f"元素定位测试 - {website['name']}",
                "capability": "OP-002 元素定位",
                "success": False,
                "score": 0,
                "error": str(e),
            }

    def _test_click_interaction(self, page, website: Dict) -> Dict:
        """OP-003: 点击交互测试"""
        try:
            page.goto(website["url"], timeout=self.timeout * 1000, wait_until="domcontentloaded")
            page.wait_for_timeout(2000)

            search_selectors = website.get("expected_elements", {}).get("search_box", "input").split(", ")
            clicked = False
            for sel in search_selectors:
                sel = sel.strip()
                try:
                    if page.locator(sel).count() > 0:
                        page.locator(sel).first.click()
                        clicked = True
                        break
                except Exception:
                    continue

            success = clicked
            score = 80 if clicked else 30

            return {
                "test_id": f"CLK_{website['domain'][:8].upper()}_001",
                "test_name": f"搜索框点击测试 - {website['name']}",
                "capability": "OP-003 点击交互",
                "success": success,
                "score": round(score, 1),
                "details": {"clicked": clicked},
            }
        except Exception as e:
            return {
                "test_id": f"CLK_{website['domain'][:8].upper()}_001",
                "test_name": f"搜索框点击测试 - {website['name']}",
                "capability": "OP-003 点击交互",
                "success": False,
                "score": 0,
                "error": str(e),
            }

    def _test_input_operation(self, page, website: Dict) -> Dict:
        """OP-004: 输入操作测试"""
        try:
            page.goto(website["url"], timeout=self.timeout * 1000, wait_until="domcontentloaded")
            page.wait_for_timeout(2000)

            test_keyword = website["test_keywords"][0]
            search_selectors = website.get("expected_elements", {}).get("search_box", "input").split(", ")

            input_success = False
            for sel in search_selectors:
                sel = sel.strip()
                try:
                    if page.locator(sel).count() > 0:
                        page.locator(sel).first.fill(test_keyword)
                        value = page.locator(sel).first.input_value()
                        input_success = value == test_keyword
                        break
                except Exception:
                    continue

            success = input_success
            score = 90 if success else 40

            return {
                "test_id": f"INP_{website['domain'][:8].upper()}_001",
                "test_name": f"搜索输入测试 - {website['name']}",
                "capability": "OP-004 输入操作",
                "success": success,
                "score": round(score, 1),
                "details": {"keyword": test_keyword, "input_success": input_success},
            }
        except Exception as e:
            return {
                "test_id": f"INP_{website['domain'][:8].upper()}_001",
                "test_name": f"搜索输入测试 - {website['name']}",
                "capability": "OP-004 输入操作",
                "success": False,
                "score": 0,
                "error": str(e),
            }

    def _test_data_extraction(self, page, website: Dict) -> Dict:
        """OP-005: 数据提取测试"""
        try:
            page.goto(website["url"], timeout=self.timeout * 1000, wait_until="domcontentloaded")
            page.wait_for_timeout(2000)

            title = page.title()
            title_ok = len(title) > 0

            links = page.locator("a[href]").all()
            link_count = len(links)

            main_content = page.locator("main, article, .content, #content").first.text_content()
            content_length = len(main_content.strip()) if main_content else 0

            success = title_ok and link_count > 0
            score = min(100, (50 if title_ok else 0) + (30 if link_count > 0 else 0) + (20 if content_length > 100 else 0))

            return {
                "test_id": f"EXT_{website['domain'][:8].upper()}_001",
                "test_name": f"数据提取测试 - {website['name']}",
                "capability": "OP-005 数据提取",
                "success": success,
                "score": round(score, 1),
                "details": {"title": title, "link_count": link_count, "content_length": content_length},
            }
        except Exception as e:
            return {
                "test_id": f"EXT_{website['domain'][:8].upper()}_001",
                "test_name": f"数据提取测试 - {website['name']}",
                "capability": "OP-005 数据提取",
                "success": False,
                "score": 0,
                "error": str(e),
            }

    def _test_screenshot(self, page, website: Dict) -> Dict:
        """OP-006: 截图能力测试"""
        try:
            page.goto(website["url"], timeout=self.timeout * 1000, wait_until="domcontentloaded")
            page.wait_for_timeout(2000)

            screenshot_path = SKILL_DIR / "tests" / "evaluation" / "screenshots" / f"{website['domain']}_test.png"
            screenshot_path.parent.mkdir(parents=True, exist_ok=True)

            page.screenshot(path=str(screenshot_path), full_page=True)
            success = screenshot_path.exists()
            score = 95 if success else 50

            return {
                "test_id": f"SHT_{website['domain'][:8].upper()}_001",
                "test_name": f"整页截图测试 - {website['name']}",
                "capability": "OP-006 截图能力",
                "success": success,
                "score": round(score, 1),
                "details": {"screenshot_path": str(screenshot_path)},
            }
        except Exception as e:
            return {
                "test_id": f"SHT_{website['domain'][:8].upper()}_001",
                "test_name": f"整页截图测试 - {website['name']}",
                "capability": "OP-006 截图能力",
                "success": False,
                "score": 0,
                "error": str(e),
            }

    def _test_scroll_operation(self, page, website: Dict) -> Dict:
        """OP-007: 滚动操作测试"""
        try:
            page.goto(website["url"], timeout=self.timeout * 1000, wait_until="domcontentloaded")
            page.wait_for_timeout(2000)

            initial_height = page.evaluate("document.body.scrollHeight")
            page.evaluate("window.scrollBy(0, 500)")
            page.wait_for_timeout(1000)
            scrolled_height = page.evaluate("document.body.scrollHeight")

            success = scrolled_height >= initial_height
            score = 85 if success else 40

            return {
                "test_id": f"SCL_{website['domain'][:8].upper()}_001",
                "test_name": f"滚动操作测试 - {website['name']}",
                "capability": "OP-007 滚动操作",
                "success": success,
                "score": round(score, 1),
                "details": {"initial_height": initial_height, "scrolled_height": scrolled_height},
            }
        except Exception as e:
            return {
                "test_id": f"SCL_{website['domain'][:8].upper()}_001",
                "test_name": f"滚动操作测试 - {website['name']}",
                "capability": "OP-007 滚动操作",
                "success": False,
                "score": 0,
                "error": str(e),
            }

    def _test_tab_management(self, page, website: Dict) -> Dict:
        """OP-008: 多标签页管理测试"""
        try:
            new_page = self.browser.new_page()
            new_page.goto("https://example.com", timeout=10000)
            new_title = new_page.title()
            new_page.close()

            return {
                "test_id": f"TAB_{website['domain'][:8].upper()}_001",
                "test_name": f"标签页管理测试 - {website['name']}",
                "capability": "OP-008 标签页管理",
                "success": True,
                "score": 90,
                "details": {"new_tab_title": new_title},
            }
        except Exception as e:
            return {
                "test_id": f"TAB_{website['domain'][:8].upper()}_001",
                "test_name": f"标签页管理测试 - {website['name']}",
                "capability": "OP-008 标签页管理",
                "success": False,
                "score": 0,
                "error": str(e),
            }

    def _test_smart_wait(self, page, website: Dict) -> Dict:
        """OP-009: 等待策略测试"""
        try:
            page.goto(website["url"], timeout=self.timeout * 1000, wait_until="domcontentloaded")

            search_box = website.get("expected_elements", {}).get("search_box", "input")
            page.wait_for_selector(search_box, timeout=5000)

            return {
                "test_id": f"WAI_{website['domain'][:8].upper()}_001",
                "test_name": f"智能等待测试 - {website['name']}",
                "capability": "OP-009 等待策略",
                "success": True,
                "score": 85,
                "details": {"wait_selector": search_box},
            }
        except Exception as e:
            return {
                "test_id": f"WAI_{website['domain'][:8].upper()}_001",
                "test_name": f"智能等待测试 - {website['name']}",
                "capability": "OP-009 等待策略",
                "success": False,
                "score": 0,
                "error": str(e),
            }

    def _test_error_recovery(self, page, website: Dict) -> Dict:
        """OP-010: 错误恢复测试"""
        try:
            # 尝试访问一个可能不存在的页面
            try:
                response = page.goto(f"{website['url']}/nonexistent_page_12345", timeout=5000)
            except Exception:
                response = None

            # 返回主页
            page.goto(website["url"], timeout=self.timeout * 1000)
            title = page.title()

            success = len(title) > 0
            score = 75 if success else 30

            return {
                "test_id": f"REC_{website['domain'][:8].upper()}_001",
                "test_name": f"错误恢复测试 - {website['name']}",
                "capability": "OP-010 错误恢复",
                "success": success,
                "score": round(score, 1),
                "details": {"recovered": success, "title": title},
            }
        except Exception as e:
            return {
                "test_id": f"REC_{website['domain'][:8].upper()}_001",
                "test_name": f"错误恢复测试 - {website['name']}",
                "capability": "OP-010 错误恢复",
                "success": False,
                "score": 0,
                "error": str(e),
            }
