{
  "version": "1.0.0",
  "description": "browser-cdp 测试工具集成配置",

  "pytest": {
    "pythonpath": ".",
    "testpaths": ["tests"],
    "python_files": ["test_*.py", "*_test.py"],
    "python_classes": ["Test*"],
    "python_functions": ["test_*"],
    "asyncio_mode": "auto",
    "markers": {
      "unit": "单元测试（mock CDP 会话）",
      "integration": "集成测试（需要真实浏览器）",
      "e2e": "端到端测试（需要真实浏览器）",
      "browser": "需要浏览器实例的测试",
      "slow": "耗时较长的测试",
      "p0": "P0 优先级测试",
      "p1": "P1 优先级测试",
      "p2": "P2 优先级测试",
      "stress": "压力测试用例标记",
      "mock": "mock 模式测试",
      "real": "真实浏览器测试"
    },
    "addopts": ["-v", "--tb=short", "-x"],
    "cache_dir": ".pytest_cache"
  },

  "asyncio": {
    "default_timeout": 30,
    "event_loop_policy": "auto",
    "max_concurrency": 10,
    "retry_delay_base": 1.0,
    "retry_delay_max": 30.0,
    "retry_backoff": 2
  },

  "requests": {
    "timeout": 15,
    "retries": 3,
    "backoff_factor": 0.5,
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "accept_language": "zh-CN,zh;q=0.9,en;q=0.8"
  },

  "aiohttp": {
    "connector_limit": 50,
    "connector_keepalive_timeout": 300,
    "client_timeout": 15,
    "max_redirects": 10
  },

  "browser_cdp": {
    "mode": "mock",
    "default_browser": "chrome",
    "headless": true,
    "stealth_mode": true,
    "chromium_path": "",
    "cdp_port": 9222,
    "max_tabs": 5,
    "screenshot_on_fail": true,
    "pause_on_fail": false
  },

  "reporting": {
    "formats": ["json", "html", "junitxml"],
    "output_dir": "./output/test_reports",
    "include_screenshots": true,
    "max_report_age_days": 30,
    "junit_xml_dir": "./output/test_reports/junit"
  },

  "ci_cd": {
    "enabled": true,
    "schedule": "0 2 * * *",
    "notify_on_failure": true,
    "notify_channels": ["log"],
    "max_parallel_jobs": 4,
    "artifact_retention_days": 14
  },

  "test_modes": {
    "mock": {
      "description": "使用 mock 数据，不启动真实浏览器",
      "enabled": true,
      "default": true
    },
    "real": {
      "description": "启动真实浏览器进行 CDP 测试",
      "enabled": true,
      "requires_browser": true
    },
    "stress": {
      "description": "HTTP 级压力测试，不依赖浏览器",
      "enabled": true,
      "requires_browser": false
    },
    "hybrid": {
      "description": "先用 mock 验证逻辑，再用真实浏览器验收",
      "enabled": true,
      "requires_browser": true
    }
  },

  "alerting": {
    "enabled": true,
    "on_pass_rate_below": 0.80,
    "on_error_rate_above": 0.15,
    "on_p95_latency_above_ms": 5000,
    "alert_on_failure": true,
    "alert_email": "admin@example.com",
    "log_level": "INFO"
  },

  "output": {
    "results_dir": "./test_results",
    "report_format": "json",
    "include_logs": true,
    "max_report_age_days": 30
  }
}
