{
  "_comment": "工具集成配置 - 步骤3产出",
  "version": "1.0.0",
  "created_at": "2026-08-13",
  "description": "browser-cdp可靠性测试工具链集成配置",

  "pytest": {
    "enabled": true,
    "markers": [
      {"name": "p0", "description": "P0优先级测试，必须通过"},
      {"name": "p1", "description": "P1优先级测试"},
      {"name": "p2", "description": "P2优先级测试"},
      {"name": "p3", "description": "P3优先级测试"},
      {"name": "mock", "description": "使用mock浏览器会话"},
      {"name": "real", "description": "需要真实浏览器"},
      {"name": "stress", "description": "压力测试"},
      {"name": "stability", "description": "稳定性测试"},
      {"name": "compatibility", "description": "兼容性测试"},
      {"name": "anti_crawl", "description": "反爬对抗测试"},
      {"name": "performance", "description": "性能测试"}
    ],
    "options": {
      "xdist_workers": 3,
      "timeout": 120,
      "verbose": true,
      "tb_style": "short"
    }
  },

  "asyncio": {
    "enabled": true,
    "event_loop_policy": "Default",
    "default_timeout": 30,
    "max_retries": 3,
    "retry_delay": 2,
    "backoff_factor": 2
  },

  "requests": {
    "enabled": true,
    "timeout": 15,
    "max_connections": 100,
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "allow_redirects": true,
    "verify_ssl": false
  },

  "aiohttp": {
    "enabled": true,
    "connector_limit": 50,
    "conn_timeout": 10,
    "sock_read_timeout": 30,
    "max_concurrent": 10
  },

  "playwright": {
    "enabled": false,
    "browser_type": "chromium",
    "headless": true,
    "viewport": {"width": 1920, "height": 1080}
  },

  "selenium": {
    "enabled": false,
    "browser_type": "chrome",
    "headless": true,
    "webdriver_manager": true
  },

  "jmeter": {
    "enabled": false,
    "path": null,
    "test_plan": null,
    "gui_mode": false
  },

  "locust": {
    "enabled": false,
    "users": 10,
    "spawn_rate": 1,
    "host": null
  },

  "k6": {
    "enabled": false,
    "script": null,
    "vusers": 10,
    "duration": "30s"
  },

  "browser_cdp": {
    "enabled": true,
    "mode": "mock", 
    "modes": ["mock", "real", "hybrid"],
    "mock": {
      "enabled": true,
      "simulate_latency_ms": 100,
      "simulate_errors": false,
      "fixed_response_time": 1.5
    },
    "real": {
      "enabled": false,
      "stealth_mode": true,
      "headless": true,
      "proxy_rotation": true,
      "cookie_persistence": false
    }
  },

  "reporting": {
    "formats": ["json", "html", "junitxml"],
    "output_dir": "tests/output/reports",
    "screenshots_dir": "tests/output/screenshots",
    "preserve_failed": true,
    "html_template": "default"
  },

  "logging": {
    "level": "INFO",
    "file": "tests/output/logs/test.log",
    "max_bytes": 10485760,
    "backup_count": 5,
    "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
  },

  "ci_cd": {
    "github_actions": {
      "enabled": true,
      "matrix": {
        "python_versions": ["3.10", "3.11", "3.12"],
        "os": ["ubuntu-latest", "windows-latest"]
      },
      "schedule": "0 2 * * *"
    },
    "nightly": {
      "enabled": true,
      "full_suite": true,
      "email_notify": false
    }
  }
}
