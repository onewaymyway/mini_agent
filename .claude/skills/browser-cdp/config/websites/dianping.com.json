      "next_page": "a.next, .next, button.load-more",
      "page_numbers": ".page-num, .c_page a"
    },
    "captcha_detection": {
      "selectors": ["#nc_1_wrapper", ".nc_wrapper", "[class*='geetest']", ".verify-wrap"],
