    "result_item": ".li_head",
    "title": ".position-name a, .job-title",
    "company": ".company_name a, .company-name",
    "salary": ".money, .salary",
    "location": ".work_addr a, .job-area",
    "experience": ".job-detail span:first-child",
    "pagination": {
      "next_page": "a.next, .pager_next, button.load-more",
      "page_numbers": ".pager_num, .page-num"
    },
    "captcha_detection": {
      "selectors": ["#nc_1_wrapper", ".nc_wrapper", "[class*='geetest']"],
      "text_patterns": ["滑动验证", "拖拽滑块"]
    }
  },
