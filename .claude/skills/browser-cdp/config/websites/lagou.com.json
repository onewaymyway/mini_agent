  "frontend_framework": "React",
  "anti_crawl_level": 3,
  "login_required": false,
  "captcha_type": "slider",
  "priority": "P1",
  "timeout": 30,
  "retry_count": 3,
  "stealth_mode": true,
  "target_success_rate": 0.75,
  "target_accuracy": 0.70,
  "custom_config": {
    "search_box": "input#search_input, input[placeholder*='职位'], .search_input",
    "search_button": "button.search_btn, button[type='submit']",
