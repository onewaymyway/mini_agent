{
  "name": "Amazon",
  "domain": "amazon.com",
  "url": "https://www.amazon.com",
  "category": "ecommerce",
  "subcategory": "shopping",
  "frontend_framework": "React",
  "anti_crawl_level": 3,
  "login_required": false,
  "captcha_type": "captcha",
  "priority": "P1",
  "timeout": 30,
  "retry_count": 3,
  "stealth_mode": true,
  "target_success_rate": 0.80,
  "target_accuracy": 0.75,
  "custom_config": {
    "search_box": "input#twotabsearchtextbox, input[name='field-keywords']",
    "search_button": "input#search-submit, button[type='submit']",
    "results": ".s-result-item, .sg-col-20-of-24",
    "result_item": ".s-result-item",
    "title": ".s-title span, .a-text-normal",
    "content": ".s-line-clamp-3, .a-size-base-plus",
    "pagination": {
      "next_page": "a.s-pagination-next, .s-pagination-next",
      "page_numbers": ".s-pagination-item"
    },
    "captcha_detection": {
      "selectors": ["#capbox, .capbox", "iframe[src*='recaptcha']"],
      "text_patterns": ["captcha", "verify you are human"]
    }
  },
  "tags": ["ecommerce", "shopping", "global", "high-traffic"],
  "created_at": "2026-08-11T13:35:00.000Z",
  "updated_at": "2026-08-11T13:35:00.000Z"
}
