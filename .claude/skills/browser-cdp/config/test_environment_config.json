{
  "test_environment": {
    "version": "1.0.0",
    "generated_at": "2026-08-13",
    "description": "Browser-CDP可靠性测试环境配置"
  },
  "browser": {
    "default_type": "chrome",
    "supported_types": ["chrome", "edge"],
    "headless": true,
    "stealth_mode": true,
    "timeout_seconds": 30,
    "page_load_timeout": 30,
    "implicit_wait": 5,
    "custom_args": [
      "--no-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu",
      "--disable-web-security",
      "--disable-features=IsolateOrigins,site-per-process"
    ]
  },
  "retry": {
    "max_retries": 3,
    "retry_delay_seconds": 2,
    "backoff_factor": 2,
    "retry_on_status": [500, 502, 503, 504, 429]
  },
  "rate_limiter": {
    "enabled": true,
    "min_delay_seconds": 1.0,
    "max_delay_seconds": 3.0,
    "jitter": true
  },
  "proxy": {
    "enabled": false,
    "pool_size": 5,
    "rotate_per_request": true
  },
  "screenshot": {
    "enabled": true,
    "on_failure": true,
    "on_assertion_failure": true,
    "directory": "output/screenshots",
    "max_size_kb": 500
  },
  "reporting": {
    "format": ["json", "html"],
    "directory": "output/reports",
    "include_screenshots": true,
    "include_metrics": true
  },
  "concurrency": {
    "max_parallel_tests": 3,
    "max_cdp_connections": 5,
    "semaphore_timeout": 60
  },
